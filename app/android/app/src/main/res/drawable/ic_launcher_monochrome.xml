    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="24"
        android:translateY="22.8">
        <group
            android:scaleX="0.94"
            android:scaleY="0.94"
            android:translateX="2.88"
            android:translateY="4.32">
            <path
                android:fillAlpha="0.5"
                android:fillColor="#ffffff"
                android:pathData="M9,70 L48,50.5 L87,70 L87,73.5 L48,93 L9,73.5 Z" />
        </group>
        <path
            android:pathData="M21,60 L37,40 L52,50 L78,16 M63,16 H78 V31"
